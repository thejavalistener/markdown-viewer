<Window x:Class="MarkdownViewerCS.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Visor Markdown" Height="700" Width="900" Background="#0d1117"
 AllowDrop="True"
 PreviewDragEnter="Window_PreviewDragOver"
 PreviewDragOver="Window_PreviewDragOver"
 Drop="Window_Drop">
 <Window.CommandBindings>
  <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed"/>
 </Window.CommandBindings>
 <Window.Resources>
  <Style x:Key="AccentButton" TargetType="Button">
   <Setter Property="Foreground" Value="#ffffff"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Padding" Value="16,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="#bf8700" CornerRadius="6"
              Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#d3a01a"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#a17200"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <wv2:WebView2 x:Name="webView" AllowDrop="True" Visibility="Collapsed"
                PreviewDragEnter="Window_PreviewDragOver"
                PreviewDragOver="Window_PreviewDragOver"
                Drop="Window_Drop"/>
  <Border x:Name="homePanel" AllowDrop="True" Background="#0d1117" MinWidth="480" MinHeight="300"
          PreviewDragEnter="Window_PreviewDragOver"
          PreviewDragOver="Window_PreviewDragOver"
          Drop="Window_Drop">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
    <Button Click="OpenFile_Click" Style="{StaticResource AccentButton}"
            HorizontalAlignment="Center"
            ToolTip="Buscar y abrir un archivo Markdown (Ctrl+O)">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="📂" Margin="0,0,8,0"/>
      <TextBlock Text="Abrir archivo"/>
     </StackPanel>
    </Button>
    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="#8b949e"
               FontSize="13" Text="o arrastra y suelta un archivo .md aquí"/>
    <Border Margin="0,24,0,0" Padding="12,10" BorderBrush="#30363d" BorderThickness="1"
            CornerRadius="6" Background="#161b22">
     <TextBlock Foreground="#8b949e" FontSize="12">
      <Run Text="Ctrl + O abrir"/><Run Text="   Ctrl + + ampliar"/><Run Text="   Ctrl + - reducir"/><Run Text="   F5 recargar"/><Run Text="   F6 modo oscuro/claro"/>
     </TextBlock>
    </Border>
   </StackPanel>
  </Border>
 </Grid>
</Window>
